# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000
VITE_AWS_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_DOMAIN=your-cognito-domain

# Backend Environment Variables
NODE_ENV=development
PORT=3000

# AWS Configuration
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=your-account-id

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/school_app
DYNAMODB_TABLE_USERS=users
DYNAMODB_TABLE_CLASSES=classes
DYNAMODB_TABLE_MARKS=marks

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=24h

# Cognito
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=eu-west-1

# S3 Configuration
S3_BUCKET_NAME=school-app-uploads
S3_REGION=eu-west-1

# SES Configuration (for emails)
SES_SENDER_EMAIL=noreply@schoolapp.com
SES_REGION=eu-west-1

# SNS Configuration (for notifications)
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:account-id:notifications
